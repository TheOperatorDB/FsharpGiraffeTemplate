<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>FsharpGiraffeTemplate.Api</RootNamespace>
        <EnableDefaultContentItems>false</EnableDefaultContentItems>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    </PropertyGroup>


    <ItemGroup>
        <Content Include="appsettings.json" />
        <Content Include="appsettings.Development.json" />
        <Compile Include="Handlers\PingHandler.fs" />
        <Compile Include="Handlers\RootHandler.fs" />
        <Compile Include="Handlers\Errors.fs" />
        <Compile Include="Program.fs"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include=".editorconfig" />
        <None Include="web.config" CopyToOutputDirectory="PreserveNewest" />
        <Content Include=".gitignore" />
        <Content Include="WebRoot\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Giraffe" Version="7.0.2" />
      <PackageReference Include="Giraffe.ViewEngine" Version="1.4.0" />
      <PackageReference Include="Thoth.Json.Giraffe" Version="6.0.0" />
      <PackageReference Include="Thoth.Json.Net" Version="12.0.0" />
    </ItemGroup>

</Project>
